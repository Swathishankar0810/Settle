# PayPal Sandbox Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BUSINESS_EMAIL=sb-business@business.example.com
PAYPAL_WEBHOOK_ID=your_registered_webhook_id
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AI Vision & Reasoning Models
# Set either OPENAI_API_KEY or GEMINI_API_KEY for live AI extraction and conversational correction.
# If omitted, Settle falls back gracefully to its smart simulated extraction and parsing engine.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Supabase (Optional: Settle uses embedded local storage engine by default, ready for Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=settle_secret_token_12345
